DATABASE_URL=postgresql://localhost:5432/datagovuk_explorer

# Basic auth is enabled only when APP_ENV=production and credentials are set
APP_ENV=development
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
LLM=api_key
LLM_MODEL=model_name
LLM_BASE_URL=url
LOCAL_MODEL=model_name
LOCAL_BASE_URL=url

# Django — SECRET_KEY is required in production; DEBUG must be false there
SECRET_KEY=change-me
DEBUG=false
